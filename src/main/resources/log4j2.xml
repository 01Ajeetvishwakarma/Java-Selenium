<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n
        </Property>
        <Property name="LOG_DIR">logs</Property>
    </Properties>

    <Appenders>

        <!-- ==================== CONSOLE APPENDER ==================== -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- ==================== GENERAL FILE APPENDER ==================== -->
        <File name="GeneralFile" fileName="${LOG_DIR}/automation.log" append="false">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </File>

        <!-- ==================== ERROR FILE APPENDER ==================== -->
        <File name="ErrorFile" fileName="${LOG_DIR}/error.log" append="false">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </File>

    </Appenders>

    <Loggers>
        <!-- Application Logger -->
        <Logger name="com.orangehrm" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="GeneralFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>

        <!-- Root Logger -->
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>